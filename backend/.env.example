LISTEN_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipboard?sslmode=disable
PUBLIC_URL=http://localhost:5173
WEB_DIR=../frontend/dist

# Leave the three OIDC values empty for anonymous-only local development.
OIDC_ISSUER=https://auth.honahec.cc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Use a long random value in production (for example: openssl rand -base64 48).
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
